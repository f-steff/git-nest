; git-nest for AmigaOS -- AmigaShell wrapper
;
; git-nest is a POSIX shell tool. This wrapper forwards to git_nest.sh via
; a sh interpreter port (for example the AmigaOS sh port from Aminet, or
; BusyBox sh on an emulated/mixed environment). If no sh is found it
; prints guidance.
;
; Place this file on your PATH (e.g. C: or SYS:Utilities) together with
; git_nest.sh and the lib/ directory. The install script in this package
; does that for you.

.key SCRIPT=""

if EXISTS SYS:C/sh
    set sh_exe SYS:C/sh
else
    if EXISTS C:sh
        set sh_exe C:sh
    else
        echo "git-nest: no 'sh' interpreter found on this system."
        echo "git-nest requires a POSIX sh port (e.g. the AmigaOS sh port)."
        failat 10
    endif
endif

; git_nest.sh must sit next to this wrapper.
if NOT EXISTS "`dir`/git_nest.sh"
    echo "git-nest: git_nest.sh not found next to this wrapper."
    failat 20
endif

; Forward all arguments to git_nest.sh through the sh interpreter.
"$sh_exe" "`dir`/git_nest.sh" <args>

exit 0
