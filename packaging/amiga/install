; git-nest installer for AmigaOS (AmigaShell)
;
; Copies git-nest to SYS:Utilities/git-nest and adds it to the PATH via
; the AmigaShell `path` command, persisted in S:Shell-Startup so new
; shells find it too.
;
; Run from the extracted package directory:   execute bin/install

.key SRC="`dir`/.."
.key DEST="SYS:Utilities/git-nest"

echo "Installing git-nest to $DEST"

; Copy the payload (bin content) into the destination.
if NOT EXISTS "$DEST"
    makedir "$DEST"
endif
copy "$SRC/bin/#?" "$DEST" all quiet

; Set the Script (S) and Execute (E) protection bits on the forwarder.
; The S bit is what makes AmigaShell run it as a script. (Unix-created
; LHA archives cannot carry the Amiga S bit, so the installer sets it
; here -- the archive only marks the file executable.)
if EXISTS "$DEST/git-nest"
    filex "$DEST/git-nest" s
    filex "$DEST/git-nest" e
    echo "  set S+E protection on $DEST/git-nest"
else
    echo "  WARNING: $DEST/git-nest not found"
endif

; Add the destination to the command search path for this shell.
path ADD "$DEST"

; Persist the path entry for future shells. The classic place is
; S:Shell-Startup; if it does not exist, create it.
if EXISTS "S:Shell-Startup"
    set ss "S:Shell-Startup"
else
    set ss "S:Shell-Startup"
    echo "; git-nest PATH entry" > "$ss"
endif

; Idempotent: only append if not already present.
set found ""
search "S:Shell-Startup" "Utilities/git-nest" quiet
if WARN
    echo "path ADD $DEST" >> "$ss"
    echo "  added PATH entry to $ss"
else
    echo "  PATH entry already present in $ss"
endif

echo "git-nest installed to $DEST"
echo "Type 'git-nest version' to verify (requires a sh interpreter port)."

exit 0
