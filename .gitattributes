# Keep repository text stable across Windows, Linux, and macOS.
* text=auto eol=lf

# Manifest and shell-facing files must stay LF.
.gitnest text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
bin/git-nest text eol=lf
bin/git_nest.sh text eol=lf
bin/git-nest.ps1 text eol=lf
bin/install.sh text eol=lf
bin/uninstall.sh text eol=lf

# AI skills are shell-facing text; keep them LF on all platforms.
*/SKILL.md text eol=lf
# The development pointer redirects to the product skill; keep its description in sync.
.agents/skills/git-nest/SKILL.md linguist-generated=true

# Batch files are intentionally CRLF for cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Distribution packaging files: extensionless AmigaShell scripts, Docker
# images, and CI workflows are all LF text.
packaging/amiga/* text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
