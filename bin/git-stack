#!/bin/sh
#
# POSIX-style entrypoint for Unix-like shells and Git's external-command
# discovery. When this file is on PATH as "git-stack", users can run either
# "git-stack ..." or "git stack ...". Keep this file small: it only locates
# the adjacent implementation file and dispatches into git_stack_main.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

. "$SCRIPT_DIR/git_stack.sh"

git_stack_main "$@"
