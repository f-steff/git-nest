#!/bin/sh
#
# POSIX-style entrypoint for Unix-like shells and Git's external-command
# discovery. When this file is on PATH as "git-lego", users can run either
# "git-lego ..." or "git lego ...". Keep this file small: it only locates
# the adjacent implementation file and dispatches into git_lego_main.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

. "$SCRIPT_DIR/git_lego.sh"

git_lego_main "$@"
